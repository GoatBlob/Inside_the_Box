if( !Obj_game.end_call)
{
if( Obj_game.on_da_phone && response == -1 && !responding && !finished_responding && !Obj_game.forced_call)
{
	if( !audio_is_playing(  people_array[array_stage][talk_stage]))
	{
		if( !start_playing)
		{
			audio_play_sound(  people_array[array_stage][talk_stage], 1, false)
			start_playing = true
		}
		else if( talk_stage < array_length( people_array[array_stage]) - 1)
		{
			talk_stage ++
			audio_play_sound( people_array[array_stage][talk_stage], 1, false)
		}
		else
		{
			finished_responding = true	
		}

	}
	sprite_index = dialogue_sprite_array[array_stage]
	image_index = talk_stage
}
else if( Obj_game.forced_call && response == -1 && !responding && !finished_responding)
{
	if( !audio_is_playing( forced_calls[Obj_game.forced_call_num][talk_stage]))
	{
		if( !start_playing)
		{
			audio_play_sound( forced_calls[Obj_game.forced_call_num][talk_stage], 1, false)
			start_playing = true
		}
		else if( talk_stage < array_length( forced_calls[Obj_game.forced_call_num]) - 1)
		{
			talk_stage ++
			audio_play_sound( forced_calls[Obj_game.forced_call_num][talk_stage], 1, false)
		}
		else
		{
			finished_responding = true	
		}

	}
	sprite_index = forced_call_sprites[Obj_game.forced_call_num]
	image_index = talk_stage	
}
else if( response != -1 && Obj_game.on_da_phone)
{
	audio_stop_all()
	finished_responding = false
	start_playing = false
	response_holder = response
	response_stage = 0
	responding = true
	response = -1
}



if( responding && Obj_game.on_da_phone && !Obj_game.forced_call)
{
	if( response_stage < array_length( response_array[array_stage][response_holder]))
	{
	if( !audio_is_playing( response_array[array_stage][response_holder][response_stage]))
	{
		if( !start_playing)
		{
			audio_play_sound( response_array[array_stage][response_holder][response_stage], 1, false)
		}
		else if( response_stage < array_length( response_array[array_stage][response_holder]) - 1)
		{
			response_stage ++
			audio_play_sound( response_array[array_stage][response_holder][response_stage], 1, false)
		}
		else
		{
			finished_responding = true
			responding = false	
		}
	}
	else
	{
		start_playing = true	
	}
	}
	else
	{
		Obj_game.end_call = true	
	}
	sprite_index = response_sprite_array[array_stage][response_holder]
	image_index = response_stage
}
else if ( responding && Obj_game.on_da_phone && Obj_game.forced_call)
{
	if( response_holder > array_length( forced_responses[Obj_game.forced_call_num]))
	{
		Obj_phone.holding = false
		Obj_game.end_call = true
		responding = false	
	}
	else if( !audio_is_playing( forced_responses[Obj_game.forced_call_num][response_holder][response_stage]))
	{
		if( !start_playing)
		{
			audio_play_sound( forced_responses[Obj_game.forced_call_num][response_holder][response_stage], 1, false)
		}
		else if( response_stage < array_length( forced_responses[Obj_game.forced_call_num][response_holder]) - 1)
		{
			response_stage ++
			audio_play_sound( forced_responses[Obj_game.forced_call_num][response_holder][response_stage], 1, false)
		}
		else
		{
			finished_responding = true
			responding = false	
		}
		sprite_index = forced_response_sprites[Obj_game.forced_call_num][response_holder]
		image_index = response_stage
	}
	else
	{
		start_playing = true	
		sprite_index = forced_response_sprites[Obj_game.forced_call_num][response_holder]
		image_index = response_stage
	}
	
}

if( finished_responding && !Obj_game.forced_call)
{
	image_index = response_stage	
}
else if( finished_responding)
{
	if( response_holder != -1)
	{
		sprite_index = forced_response_sprites[Obj_game.forced_call_num][response_holder]
		image_index = response_stage	
	}
	else
	{
		sprite_index = forced_call_sprites[Obj_game.forced_call_num]
		image_index = talk_stage		
	}
}
}

if( Obj_game.on_da_phone )
{
	visible = true	
}
else
{
	finished_responding = false
	responding = false
	response = -1
	response_holder = -1
	response_stage = 0
	talk_stage = 0
	visible = false
}









